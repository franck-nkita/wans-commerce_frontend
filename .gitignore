# Dépendances (reconstruites par `npm ci` depuis package-lock.json)
node_modules/

# Build de production (généré par `npm run build`)
dist/
dist-ssr/
*.tsbuildinfo

# Tests
coverage/

# Variables d'environnement : seul le modèle est versionné
.env
.env.*
!.env.example

# Journaux
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Cache Vite / outils
.vite/
.cache/
.eslintcache

# Éditeurs et systèmes
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
