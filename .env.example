# Variables du frontend (Vite). Copier ce fichier en frontend/.env puis adapter les valeurs.
# Toutes les variables VITE_* sont incluses dans le bundle envoyé au navigateur : n'y placez jamais de secret.
# Vite ne relit pas ce fichier à chaud : relancez `npm run dev` après modification.

# "demo" : données de démonstration locales ; "api" : backend Django.
VITE_DATA_SOURCE=demo
# URL du backend VUE PAR LE NAVIGATEUR, sans barre oblique finale (jamais un nom de service Docker).
# Vide = même origine (production derrière Caddy).
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api/v1
